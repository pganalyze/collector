FROM rockylinux:8

# Build arguments
ARG VERSION
ENV NAME pganalyze-collector

ENV RPM_DIR /rpm
RUN mkdir -p $RPM_DIR
RUN mkdir -p $RPM_DIR/systemd

RUN dnf install -y -q rpm-sign createrepo_c gnupg2

RUN echo "%_gpg_name team@pganalyze.com" > /root/.rpmmacros

# Pin SHA256 digests, since RHEL 9 and newer reject SHA-1 signed packages.
# gpg 2.2 already defaults to SHA256, this only makes the requirement explicit.
RUN echo "%_gpg_digest_algo sha256" >> /root/.rpmmacros

# Never prompt interactively
RUN echo "%_gpg_sign_cmd_extra_args --batch" >> /root/.rpmmacros

COPY sync_rpm.sh /root
COPY $NAME-$VERSION-1.x86_64.rpm $RPM_DIR/systemd/$NAME-$VERSION-1.x86_64.rpm
COPY $NAME-$VERSION-1.aarch64.rpm $RPM_DIR/systemd/$NAME-$VERSION-1.aarch64.rpm

VOLUME ["/repo"]
