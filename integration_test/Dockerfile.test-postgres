ARG BASE_IMAGE=postgres:17
FROM ${BASE_IMAGE}

# Workaround for https://github.com/docker-library/postgres/issues/1112
RUN echo en_US.UTF-8 UTF-8 >> /etc/locale.gen

ARG TARGETARCH

ENV GOVERSION 1.26.5
ENV CODE_DIR /collector
ENV PATH $PATH:/usr/local/go/bin

# Packages required for both building and packaging
RUN apt-get update -qq && apt-get install -y -q build-essential git curl

# Golang
RUN curl -o go.tar.gz -sSL "https://go.dev/dl/go${GOVERSION}.linux-${TARGETARCH}.tar.gz"
RUN tar -C /usr/local -xzf go.tar.gz

# Vector, only needed by the otel-vector test
ARG INSTALL_VECTOR=false
RUN if [ "$INSTALL_VECTOR" = true ]; then \
      bash -c "$(curl -L https://setup.vector.dev)" && apt-get install -y vector; \
    fi

# Build the collector
COPY . $CODE_DIR
WORKDIR $CODE_DIR
# Share Go's build cache across the test images, which would otherwise each
# compile the collector from scratch
RUN --mount=type=cache,target=/root/.cache/go-build make build_dist

# Make sure collector state can be saved
RUN mkdir /var/lib/pganalyze-collector/

RUN cp $CODE_DIR/pganalyze-collector /usr/bin/
RUN cp $CODE_DIR/pganalyze-collector-helper /usr/bin/
